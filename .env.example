# Commerce OS — environment
#
# Everything is optional. With no .env file the system runs fully offline:
# deterministic AI, simulated payments, simulated supplier.
# Copy to .env.local and fill in only what you want live.

# ── AI (optional) ─────────────────────────────────────────────────────────────
# Any OpenAI-compatible endpoint. Groq, Gemini and OpenRouter free tiers all
# work through one adapter. On any error the system falls back to the
# deterministic engine and the UI says so.
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_API_KEY=
# AI_MODEL=llama-3.3-70b-versatile

# ── Accounts & API keys (built-in, no env needed) ────────────────────────────
# Passwords are scrypt-hashed per account; sessions and API keys live in the
# database. These knobs only shape the defaults:
# AUTH_SESSION_TTL_DAYS=7        session lifetime (default 7)
# AUTH_SIGNUP_OPEN=true         false disables account creation at the route

# ── Public deployments (optional) ────────────────────────────────────────────
# Puts the whole site (except /api/health) behind one shared password over
# HTTP Basic. Unset, the gate is off entirely. This is a demo gate, not an
# authentication system.
# DEMO_PASSWORD=

# ── Razorpay test mode (optional) ────────────────────────────────────────────
# Makes the merchant transactable by an AI buyer through Razorpay's sandbox.
# TEST KEYS ONLY — a key starting rzp_live_ is refused by the code, and
# without RAZORPAY_TEST_MODE=1 the credentials are treated as unconfigured.
# Unset, payment references are simulated and identified as TXN_DEMO_*.
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=
# RAZORPAY_TEST_MODE=1

# ── Printful (optional) ──────────────────────────────────────────────────────
# Draft orders only — the confirm call is deliberately not implemented, so no
# agent can cause a charge or a shipment.
# PRINTFUL_TOKEN=
# PRINTFUL_STORE_ID=
# PRINTFUL_VARIANT_ID=
# PRINTFUL_RECIPIENT_NAME=
# PRINTFUL_RECIPIENT_ADDRESS1=
# PRINTFUL_RECIPIENT_CITY=
# PRINTFUL_RECIPIENT_STATE=
# PRINTFUL_RECIPIENT_COUNTRY=
# PRINTFUL_RECIPIENT_ZIP=
# PRINTFUL_PLACEMENT_URL=

# ── MCP server (optional) ────────────────────────────────────────────────────
# The agent identity an external MCP client is bound to. Default: analytics,
# which holds only read permissions — an external client is not privileged.
# MCP_AGENT_ID=analytics

# ── Data ──────────────────────────────────────────────────────────────────────
# DATABASE_PATH=data/commerce.db
